{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/sync.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/calendar.js",
      "use": "@vercel/node"
    },
    {
      "src": "{index.html,app.js,styles.css,ai-hooks-data.js,manifest.json,sw.js,*.png,sync-data.json,favicon.png}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/sync(.*)",
      "dest": "/api/sync.js$1"
    },
    {
      "src": "/api/calendar(.*)",
      "dest": "/api/calendar.js$1"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}